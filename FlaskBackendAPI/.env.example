# Flask/Mongo base config (see README for details)
PORT=3001
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*
SECRET_KEY=dev-secret

# Mongo
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=network_inventory
MONGODB_COLLECTION_DEVICES=devices

# Ping configuration
# Enable/disable ping endpoint. Set to "false" to return 501 for POST /api/devices/<id>/ping
PING_ENABLED=true
# Number of echo requests to send
PING_COUNT=2
# Timeout per request in milliseconds
PING_TIMEOUT_MS=800
# Time To Live (IP TTL)
PING_TTL=64
