# Flask
PORT=3001
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# For dev you may leave SECRET_KEY commented, but set for non-dev
# SECRET_KEY=change-me

# CORS (set to frontend origin in dev)
CORS_ALLOW_ORIGINS=http://localhost:3000

# MongoDB
# Configure these to enable CRUD operations
# Example: mongodb://localhost:27017
# MONGODB_URI=
# MONGODB_DB_NAME=network_devices
MONGODB_COLLECTION_DEVICES=devices

# Optional Mongo tuning/TLS
# MONGODB_CONNECT_TIMEOUT_MS=2000
# MONGODB_SOCKET_TIMEOUT_MS=20000
# MONGODB_MAX_POOL_SIZE=100
# MONGODB_TLS=false
# MONGODB_TLS_CA_FILE=
